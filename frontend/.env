# Backend API base URL (default; overridable in-app on the Login screen).
VITE_API_URL=https://gatepass-backend-21cn.onrender.com/api

# Deployed GatePass contract address — same as backend's CONTRACT_ADDRESS.
VITE_CONTRACT_ADDRESS=0xc44c4856eFE149241B4a36B0a5BB9935CA396518

# Chain ID approvers' MetaMask must be on: 80002 = Polygon Amoy.
VITE_CHAIN_ID=80002
