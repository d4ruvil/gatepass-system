# MongoDB Atlas free-tier connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gatepass

# Any long random string — used to sign login sessions.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Blockchain RPC: http://127.0.0.1:8545 for local Hardhat node, or the Amoy RPC URL.
RPC_URL=http://127.0.0.1:8545

# Deployed GatePass contract address (from contracts/deployments/<network>.json).
CONTRACT_ADDRESS=

# Private key of the wallet holding BACKEND_ROLE on GatePass — this is the
# relayer that submits pass requests on behalf of students. Needs testnet
# MATIC for gas on Amoy. NEVER commit the real .env file.
RELAYER_PRIVATE_KEY=

# Optional override; defaults to ../contracts/artifacts/contracts/GatePass.sol/GatePass.json
GATEPASS_ARTIFACT_PATH=
