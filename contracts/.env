# RPC endpoint for Polygon Amoy testnet.
# Free options: https://rpc-amoy.polygon.technology (public, rate-limited)
# or get a dedicated free-tier endpoint from Alchemy (https://www.alchemy.com) or Infura.
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Private key of the account running deploy/admin scripts (pays gas).
# NEVER commit the real .env file. Get free test MATIC from https://faucet.polygon.technology
PRIVATE_KEY=c9e19f8bd14bd8a67dec8417b1b88afb3bcc7341e6d0572c091a66048851f83d

# Optional: used to verify the contract source on Amoy PolygonScan.
POLYGONSCAN_API_KEY=

# Optional: comma-separated addresses of the AdminMultiSig owners and how many
# must confirm an action. admin-testnet + coordinator + dean, 2-of-3.
ADMIN_SIGNERS=0x9eb7eaA366425eAc4A67D08B448293e3007309a6,0x5C3991D16Ca392104E1257d5533d88b03a6d8bC7,0x53fA904CAF2Bf82231B293A4511272a56bE7A53A
ADMIN_THRESHOLD=2

# Wallet addresses to grant roles to after deployment (see scripts/grantRoles.js
# for the single-EOA-admin path, or scripts/proposeAdminAction.js for multisig).
COORDINATOR_ADDRESS=0x5C3991D16Ca392104E1257d5533d88b03a6d8bC7
LAB_INCHARGE_ADDRESS=0xc2E34492df2582cBE13cf5A801323ACc03835851
DEAN_ADDRESS=0x53fA904CAF2Bf82231B293A4511272a56bE7A53A
BACKEND_RELAYER_ADDRESS=0xf1dA4108fd960F8Fd890f6cEe3c5564CEC056761
