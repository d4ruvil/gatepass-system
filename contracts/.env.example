# RPC endpoint for Polygon Amoy testnet.
# Free options: https://rpc-amoy.polygon.technology (public, rate-limited)
# or get a dedicated free-tier endpoint from Alchemy (https://www.alchemy.com) or Infura.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the account running deploy/admin scripts (pays gas).
# NEVER commit the real .env file. Get free test MATIC from https://faucet.polygon.technology
PRIVATE_KEY=

# Optional: used to verify the contract source on Amoy PolygonScan.
POLYGONSCAN_API_KEY=

# Optional: comma-separated addresses of the AdminMultiSig owners (e.g. 3 of:
# IT admin, HOD, a second faculty member) and how many must confirm an action.
# If set, deploy.js deploys AdminMultiSig and makes IT the GatePass admin
# instead of a single EOA — no one person can grant/revoke roles alone.
# If left blank, the deployer's own account is the admin (fine for quick local testing).
ADMIN_SIGNERS=
ADMIN_THRESHOLD=2

# Wallet addresses to grant roles to after deployment (see scripts/grantRoles.js).
COORDINATOR_ADDRESS=
LAB_INCHARGE_ADDRESS=
DEAN_ADDRESS=
BACKEND_RELAYER_ADDRESS=
